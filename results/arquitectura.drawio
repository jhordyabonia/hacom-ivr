                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Flujo de registro (UE→200 OK):&lt;/b&gt;&lt;br&gt;1) REGISTER→P-CSCF (R-URI del dominio)&amp;nbsp;&lt;br&gt;2) P-CSCF: 100 + rewrite RURI + pending contact&lt;br&gt;3) I-CSCF: UAR→HSS → UAA con S-CSCF → relay&lt;br&gt;4) S-CSCF: MAR→HSS → MAA (AV) → 401 challenge&lt;br&gt;5) UE re-envía REGISTER (digest)&lt;br&gt;6) S-CSCF: valida auth; SAR→HSS → SAA (perfil+iFC); 200 OK + Service-Route" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="220" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="legend2" value="&lt;b&gt;Flujo de llamada (UE→AS):&lt;/b&gt;&lt;br&gt;1) UE: INVITE 0100002@ims...→P-CSCF (RTPEngine)&lt;br&gt;2) S-CSCF: evalúa iFC#1 (INVITE+SC0)→AS&lt;br&gt;3) Asterisk (identify 172.30.0.7) responde 200 + IVR&lt;br&gt;4) ACK; RTP bidireccional vía RTPEngine; BYE al colgar" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="380" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="legend3" value="&lt;b&gt;VMS (buzón de voz, 0100003):&lt;/b&gt;&lt;br&gt;1) UE: INVITE 0100003@ims... por iFC al AS (audio vía RTPEngine)&lt;br&gt;2) Asterisk: prompt vm-* → graba → msg*.wav (PCM16 8 kHz)&lt;br&gt;3) Almacén: …/voicemail/default/0100003/INBOX&lt;br&gt;4) mims_ui: pestaña VMS lista y reproduce los mensajes (GET /api/vms/media)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="500" width="270" height="110" as="geometry"/>
                </mxCell>
