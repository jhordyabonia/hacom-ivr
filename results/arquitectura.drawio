                <mxCell id="ui" value="&lt;b&gt;Interfaz — mims_ui&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;172.30.0.14:8888 (host :8090)&lt;br&gt;Flask + Docker SDK (socket)&lt;br&gt;pestañas: Estado, E2E (13/13), Operación,&lt;br&gt;VMS + reproductor, Config, Logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
