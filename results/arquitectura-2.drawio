                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l5" value="Cx: MAR/MAA · SAR/SAA (perfil + iFC)" style="edgeLabel;html=1;fontSize=9;fontColor=#d79b00;" parent="e5" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-40" y="-60" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontColor=#b85450;" parent="1" source="pcscf" target="scscf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l6" value="Mw: INVITE (SessionCase 0)" style="edgeLabel;html=1;fontSize=9;fontColor=#b85450;" parent="e6" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-90" y="-110" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontColor=#b85450;" parent="1" source="scscf" target="kamailio" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l7" value="ISC: INVITE por iFC#1 → AS Frontera (Kamailio)" style="edgeLabel;html=1;fontSize=9;fontColor=#b85450;" parent="e7" vertex="1" connectable="0">
                    <mxGeometry x="-0.35" relative="1" as="geometry">
                        <mxPoint x="120" y="-60" as="offset"/>
