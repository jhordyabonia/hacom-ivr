                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l7b" value="SIP INVITE traducido (ISC → plano)" style="edgeLabel;html=1;fontSize=9;fontColor=#b85450;" parent="e7b" vertex="1" connectable="0">
                    <mxGeometry x="0.05" relative="1" as="geometry">
                        <mxPoint x="-42" y="-18" as="offset"/>
                    </mxGeometry>
