                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l1" value="Gm: REGISTER / INVITE" style="edgeLabel;html=1;fontSize=9;" parent="e1" vertex="1" connectable="0">
                    <mxGeometry x="-0.3" relative="1" as="geometry">
                        <mxPoint as="offset"/>
