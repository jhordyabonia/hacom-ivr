                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l8b" value="RTP relay" style="edgeLabel;html=1;fontSize=9;fontColor=#9673a6;" parent="e8b" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#999999;" parent="1" source="dns" target="ue" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l9" value="resolución DNS del operador" style="edgeLabel;html=1;fontSize=9;fontColor=#999;" parent="e9" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ui" value="&lt;b&gt;Interfaz — mims_ui&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;gestión de la plataforma propia&lt;br&gt;Flask + Docker SDK&lt;br&gt;pestañas: Estado, E2E, Operación,&lt;br&gt;VMS + reproductor, Config, Logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="60" width="270" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="eUi" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#999999;" parent="1" source="ui" target="kamailio" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lUi" value="gestiona/valida la plataforma (socket Docker)" style="edgeLabel;html=1;fontSize=9;fontColor=#999;" parent="eUi" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Flujo de registro (UE→200 OK):&lt;/b&gt;&lt;br&gt;1) REGISTER→P-CSCF (R-URI del dominio)&amp;nbsp;&lt;br&gt;2) P-CSCF: 100 + rewrite RURI + pending contact&lt;br&gt;3) I-CSCF: UAR→HSS → UAA con S-CSCF → relay&lt;br&gt;4) S-CSCF: MAR→HSS → MAA (AV) → 401 challenge&lt;br&gt;5) UE re-envía REGISTER (digest/AKA)&lt;br&gt;6) S-CSCF: SAR→HSS → SAA (perfil + iFC); 200 OK + Service-Route" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="180" width="270" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="legend2" value="&lt;b&gt;Flujo de llamada (UE→AS):&lt;/b&gt;&lt;br&gt;1) UE: INVITE 0100002@ims...→P-CSCF&lt;br&gt;2) S-CSCF: evalúa iFC#1 (INVITE+SC0)→AS Frontera&lt;br&gt;3) Kamailio: recibe por ISC, traduce a SIP plano y&lt;br&gt;&amp;nbsp;&amp;nbsp;re-origina hacia el Asterisk&lt;br&gt;4) Asterisk: 200 + IVR; ACK; RTP vía RTPEngine" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="340" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="legend3" value="&lt;b&gt;VMS (buzón de voz, 0100003):&lt;/b&gt;&lt;br&gt;1) INVITE 0100003 por iFC → AS Frontera&lt;br&gt;2) Kamailio traduce → Asterisk: prompt vm-* → graba&lt;br&gt;&amp;nbsp;&amp;nbsp;→ msg*.wav (PCM16 8 kHz)&lt;br&gt;3) Almacén: …/voicemail/default/0100003/INBOX&lt;br&gt;4) mims_ui: pestaña VMS lista y reproduce (GET /api/vms/media)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="480" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="legend4" value="&lt;b&gt;¿Por qué Kamailio + Asterisk?&lt;/b&gt;&lt;br&gt;• El S-CSCF de la operadora habla ISC (TS 29.228/24.229):&lt;br&gt;&amp;nbsp;&amp;nbsp;Route/Record-Route ISC, P-Charging-Vector,&lt;br&gt;&amp;nbsp;&amp;nbsp;P-Asserted-Identity, auth del diálogo AS.&lt;br&gt;• Asterisk directo: no implementa la pila IMS →&lt;br&gt;&amp;nbsp;&amp;nbsp;diálogos ISC malformados, timers, caída de sesión.&lt;br&gt;• Kamailio SÍ tiene soporte IMS: ims_isc, ims_diameter_server,&lt;br&gt;&amp;nbsp;&amp;nbsp;ims_auth/usrloc + rtpengine/dialog/dispatcher →&lt;br&gt;&amp;nbsp;&amp;nbsp;B2BUA interworking ISC↔SIP plano hacia el Asterisk." style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="630" width="270" height="190" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>