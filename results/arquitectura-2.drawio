<mxfile host="65bd71144e">
    <diagram id="vms-produccion-isc" name="VMS en produccion (operadora)">
        <mxGraphModel dx="1434" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="VMS en producción — Core IMS de la operadora (P/I/S-CSCF + HSS) → AS Frontera Kamailio → Asterisk (IVR + VMS)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ue" value="&lt;b&gt;UE (usuario)&lt;/b&gt;&lt;br&gt;pjsua / móvil IMS&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;siempre conectado al&lt;br&gt;núcleo de la operadora&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="30" y="120" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="contOp" value="Núcleo de la OPERADORA — Core IMS (P-CSCF / I-CSCF / S-CSCF / HSS)" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;fillColor=#f4f7f4;strokeColor=#82b366;dashed=1;startSize=28;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="300" y="100" width="760" height="570" as="geometry"/>
                </mxCell>
                <mxCell id="hss" value="&lt;b&gt;HSS (operadora)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;Cx: perfil del suscriptor&lt;br&gt;iFC del servicio IVR/VMS&lt;br&gt;(en la maqueta: PyHSS + maqueta_ifc.xml)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="contOp" vertex="1">
                    <mxGeometry x="510" y="370" width="230" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="pcscf" value="&lt;b&gt;P-CSCF (operadora)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;Gm: SIP del usuario&lt;br&gt;IPSEC/IKI (o UDP/TCP)&lt;br&gt;descubrimiento por DNS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="320" y="260" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="icscf" value="&lt;b&gt;I-CSCF (operadora)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;selección de S-CSCF&lt;br&gt;interfaz Cx (Diameter)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="660" y="140" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="scscf" value="&lt;b&gt;S-CSCF (operadora)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;evalúa el iFC del perfil HSS&lt;br&gt;deriva al AS por ISC&lt;br&gt;No accede al Asterisk (ISC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="580" y="500" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="dns" value="&lt;b&gt;DNS del operador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;descubrimiento P-CSCF&lt;br&gt;NAPTR/SRV de IMS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="50" y="380" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="l11" value="&lt;b style=&quot;color:#9673a6;&quot;&gt;NO se salta:&lt;/b&gt; &lt;font color=&quot;#333333&quot;&gt;el S-CSCF no reenvía el INVITE al Asterisk directo entre dominios: si pierde el estado ISC (Route/Record-Route, P-Charging, auth AS) la sesión se cae — falta de compatibilidad de protocolos.&lt;/font&gt;" style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="330" y="620" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="contSvc" value="Plataforma de servicios PROPIA — Borde del AS (interworking) + AS aplicación" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;fillColor=#f2f7fb;strokeColor=#6c8ebf;dashed=1;startSize=28;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="750" width="640" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="rtpe" value="&lt;b&gt;RTPEngine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;anclaje de medios&lt;br&gt;reemplazo SDP / relay RTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="contSvc" vertex="1">
                    <mxGeometry x="150" y="220" width="190" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="kamailio" value="&lt;b&gt;AS Frontera — Kamailio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;B2BUA / interworking ISC → SIP plano&lt;br&gt;módulos IMS: ims_isc, ims_diameter_server,&lt;br&gt;ims_auth/usrloc; rtpengine, dialog, dispatcher&lt;br&gt;quita/añade P-Charging-Vector, P-Asserted-Identity,&lt;br&gt;gestión de Route/Record-Route ISC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="contSvc" vertex="1">
                    <mxGeometry x="390" y="50" width="240" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;fontColor=#9673a6;" parent="contSvc" source="kamailio" target="rtpe" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l8" value="anclaje de medios (rtpengine)" style="edgeLabel;html=1;fontSize=9;fontColor=#9673a6;" parent="e8" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-95" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="asterisk" value="&lt;b&gt;AS aplicación — Asterisk&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;SIP plano (no ISC)&lt;br&gt;ims-in → 0100002 IVR&lt;br&gt;0100003 → VoiceMail (VMS)&lt;br&gt;INBOX msg*.wav (PCM16)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="70" y="800" width="210" height="115" as="geometry"/>
                </mxCell>
