                <mxCell id="l3" value="Mw: hacia S-CSCF (UAA)" style="edgeLabel;html=1;fontSize=9;" parent="e3" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d79b00;" parent="1" source="icscf" target="hss" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l4" value="Cx: UAR/UAA" style="edgeLabel;html=1;fontSize=9;fontColor=#d79b00;" parent="e4" vertex="1" connectable="0">
