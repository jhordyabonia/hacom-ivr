  <diagram id="p3" name="3. Almacenamiento objetivo (depósito y recuperación)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Arquitectura objetivo de almacenamiento y recuperación de buzones (PROPUESTA) — ~300 000 buzones, 500 000 mensajes/día" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="2100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="st" value="[INFERENCE]/[ASSUMPTION] Diseño propuesto, no implementado. D = depósito · R = recuperación por voz · W = recuperación web · L = ciclo de vida. Dimensionamiento en almacenamiento_y_recuperacion_buzones.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="2100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="A" value="Plano de medios — AS VMS (N+1 nodos FreeSWITCH sin estado)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;collapsible=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="fsn" value="&lt;b&gt;FreeSWITCH nodo i&lt;/b&gt; (1..N)&lt;br&gt;record → WAV PCM16 8 kHz en spool local&lt;br&gt;playback desde caché local (mod_http_cache) o GET HTTP&lt;br&gt;G.711 / AMR-WB hacia la red (transcodifica al reproducir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="A">
          <mxGeometry x="20" y="40" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="spool" value="&lt;b&gt;Spool local&lt;/b&gt; SSD / tmpfs&lt;br&gt;/var/spool/vm/&amp;lt;uuid&amp;gt;.wav&lt;br&gt;se borra tras ACK de subida" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="A">
          <mxGeometry x="20" y="175" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Caché de lectura LRU&lt;/b&gt;&lt;br&gt;objetos .opus recientes&lt;br&gt;prefetch al validar el PIN" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="A">
          <mxGeometry x="270" y="175" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Agente de ingesta local&lt;/b&gt; (ESL: RECORD_STOP / CHANNEL_HANGUP)&lt;br&gt;1) transcodifica WAV → Opus 16 kbit/s mono, Ogg&lt;br&gt;2) PUT objeto (Content-MD5, If-None-Match) con reintentos&lt;br&gt;3) publica vm.stored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="A">
          <mxGeometry x="20" y="300" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pinr" value="PIN / identidad: VM API (hash Argon2id + pepper en KMS);&lt;br&gt;bloqueo tras 3 intentos; PIN nunca en logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="A">
          <mxGeometry x="20" y="435" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mwiA" value="Suscripciones MWI: el AS que recibe SUBSCRIBE (hash por buzón en AS-Front) emite NOTIFY al recibir el evento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="A">
          <mxGeometry x="20" y="515" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="B" value="Ingesta asíncrona" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;collapsible=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="380" height="600" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Cola durable&lt;/b&gt; (Kafka / RabbitMQ quorum / Redis Streams)&lt;br&gt;tópico vm.stored · clave = mailbox_id (orden por buzón)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="B">
          <mxGeometry x="20" y="40" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wk" value="&lt;b&gt;Workers de metadatos&lt;/b&gt; (escalado horizontal)&lt;br&gt;INSERT vm_message … ON CONFLICT (msg_id, created_at) DO NOTHING&lt;br&gt;HINCRBY mwi:{buzón} new 1&lt;br&gt;publica mwi.changed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="B">
          <mxGeometry x="20" y="155" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dlq" value="&lt;b&gt;DLQ&lt;/b&gt; + reintentos exponenciales&lt;br&gt;(1 s → 15 min; alerta a los 3 fallos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="B">
          <mxGeometry x="20" y="290" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rec" value="&lt;b&gt;Reconciliador&lt;/b&gt; (diario)&lt;br&gt;spool sin ACK → re-subida · objeto sin fila → re-publica · fila sin objeto → alerta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="B">
          <mxGeometry x="20" y="385" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Cc" value="Servicio de buzones" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;collapsible=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="130" width="380" height="600" as="geometry" />
        </mxCell>
        <mxCell id="vmapi" value="&lt;b&gt;VM API&lt;/b&gt; (REST / gRPC, sin estado)&lt;br&gt;GET /mailboxes/{id}/messages?folder=inbox&amp;amp;cursor=…&lt;br&gt;PATCH /messages/{id} (read / saved / deleted)&lt;br&gt;POST /mailboxes/{id}/pin:verify&lt;br&gt;GET /messages/{id}/audio → 302 URL prefirmada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="Cc">
          <mxGeometry x="20" y="40" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mwi" value="&lt;b&gt;Publicador MWI&lt;/b&gt;&lt;br&gt;mwi.changed → MESSAGE_WAITING (ESL) en el AS de la suscripción" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="Cc">
          <mxGeometry x="20" y="205" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="life" value="&lt;b&gt;Jobs de ciclo de vida&lt;/b&gt; [ASSUMPTION]&lt;br&gt;nuevos / leídos: expiran a 30 d · guardados: 90 d&lt;br&gt;borrado lógico → purga física a 7 d&lt;br&gt;DROP PARTITION mensual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="Cc">
          <mxGeometry x="20" y="300" width="340" height="100" as="geometry" />
