        <mxCell id="st_vm2" value="&lt;b&gt;Capa del contenedor — sin volumen&lt;/b&gt;&lt;br&gt;/var/lib/freeswitch/storage/voicemail/default/&lt;br&gt;&amp;lt;dominio&amp;gt;/&amp;lt;MSISDN&amp;gt;/msg_&amp;lt;uuid&amp;gt;.wav + índice mod_voicemail&lt;br&gt;se pierde al recrear la tarea Swarm" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;strokeWidth=2;dashed=1;" vertex="1" parent="L5">
