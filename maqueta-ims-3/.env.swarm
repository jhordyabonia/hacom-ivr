# .env.swarm — variables del despliegue Docker Swarm (DEV, 3 nodos), sobre .env.
# Reconstruido el 2026-10-14 a partir del entorno de los servicios del stack mims3.
# En Swarm las IP de .env (172.32.0.x) no son fijas: los init resuelven nombres
# de servicio y la IP overlay propia cuando SWARM_MODE=1.
SWARM_MODE=1
MYSQL_HOST=mims3_mysql
REDIS_HOST=mims3_redis
RTPENGINE_HOST=mims3_rtpengine
FREESWITCH_HOST=mims3_freeswitch
PCSCF_HOST=mims3_pcscf
PYHSS_API_HOST=mims3_pyhss_api
# AS Frontera: solo acepta peticiones iniciales desde la red ISC (S-CSCF).
ASFRONT_ALLOWED_CIDR=172.33.0.0/24
# Acceso externo por VPN (softphone SIP Digest): P-CSCF 5060 y un pool RTP
# propio publicados en modo host en el nodo Core IMS. Vacío = solo overlay.
EXT_ADVERTISE_IP=192.168.5.231
RTP_EXT_PORT_MIN=49900
RTP_EXT_PORT_MAX=49919
# Perfil no-3GPP (TS 33.203 Anexo N) en el S-CSCF: 1 = Digest MD5 para
# clientes sin sec-agree. Solo durante la demo: check_3gpp A4 lo detecta.
NON3GPP_DIGEST=1
