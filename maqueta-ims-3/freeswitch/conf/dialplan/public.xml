<!--
  FreeSWITCH como AS aplicación (SIP plano, sin Asterisk).
  Recibe INVITEs del AS Frontera (asfront) habilitados por las iFC del S-CSCF:
    - 0100002 -> IVR interactivo: motor Lua (menú DTMF por país, flujos JSON).
                 Flujos: freeswitch/flows/<pais>.json ; motor: freeswitch/scripts/ivr_flow.lua
                 Persiste elección en /mnt/freeswitch/logs/ivr_cdr.jsonl (CDR de opción).
    - 0100003 -> VMS: graba el mensaje del UE en INBOX/msg*.wav
    - 00101xxxxx -> FEAT-02 VMS: deposit del buzón por MSISDN (mod_voicemail) + MWI (SUBSCRIBE/NOTIFY).
    - 0100004 -> FEAT-02 VMS: recuperación por PIN (vm_pin.lua) + menú de escucha/borrado.
  RTP path: UE <-> RTPEngine <-> FreeSWITCH (el ancla de RTP lo hace RTPEngine)
-->
<include>
  <context name="public">

    <!-- IVR interactivo con menú DTMF (FEAT-01). País por variable, costumizable en S-CSCF/iFC. -->
    <extension name="ivr_menu_0100002">
      <condition field="destination_number" expression="^0100002$">
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="set" data="ivr_flow=cl"/>
        <action application="lua" data="ivr_flow.lua ${ivr_flow}"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- VMS: graba el mensaje hablado/tono del UE -->
    <extension name="vms_0100003">
      <condition field="destination_number" expression="^0100003$">
        <action application="answer"/>
        <action application="sleep" data="1000"/>
        <action application="set" data="vms_dir=/var/lib/freeswitch/storage/vms/0100003/INBOX"/>
        <action application="system" data="mkdir -p ${vms_dir}"/>
        <action application="strftime" data="vms_file=${vms_dir}/msg_%Y%m%d_%H%M%S.wav"/>
        <action application="record" data="${vms_file} 300 0 0"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- FEAT-02: deposit VMS por MSISDN (TS 24.604 CDIV -> VMS). El INVITE llega
         por la iFC terminating-unregistered (SessionCase 2) cuando el UE destino
         no está registrado. mod_voicemail graba en el buzón del MSISDN y emite
         MESSAGE_WAITING: mod_sofia envía el NOTIFY message-summary a las
         suscripciones MWI vigentes del dueño (TS 24.606). -->
    <extension name="vms_deposit_subscriber">
      <condition field="destination_number" expression="^(00101[0-9]{5})$">
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="set" data="vm_domain=ims.mnc001.mcc001.3gppnetwork.org"/>
        <action application="set" data="skip_greeting=true"/>
        <action application="set" data="skip_instructions=true"/>
        <action application="log" data="INFO VMS_DEPOSIT start id=$1"/>
        <action application="voicemail" data="default ${vm_domain} $1"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- FEAT-02: recuperación de buzón. pjsua no hace autenticación SIP aquí: el
         PIN (vas.subscriber_pin) se valida con la API de la UI y, si es correcto,
         vm_pin.lua abre el menú de mod_voicemail (escuchar 1 / borrar 7 + confirmar). -->
    <extension name="vms_retrieve_0100004">
      <condition field="destination_number" expression="^0100004$">
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="set" data="vm_domain=ims.mnc001.mcc001.3gppnetwork.org"/>
        <action application="lua" data="vm_pin.lua ${vm_domain} ${caller_id_number}"/>
        <action application="hangup"/>
      </condition>
    </extension>

  </context>
</include>